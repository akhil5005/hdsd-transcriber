# Frontend config. Copy to .env.local for local dev (git-ignored).
# Vite inlines VITE_* at BUILD time, so changing this on Vercel needs a redeploy.

# Base URL of the FastAPI backend, with no trailing slash.
#   local:      leave blank to use the Vite dev proxy (see vite.config.js)
#   production: https://<service>.onrender.com
VITE_API_URL=

# Where the Vite dev server proxies /api when VITE_API_URL is blank.
VITE_API_TARGET=http://127.0.0.1:8000
