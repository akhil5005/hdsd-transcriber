# ============================================================================
# HDSD Dysarthric-Speech Hindi Transcriber -- backend configuration
# Copy to .env and fill in real secrets. .env is git-ignored.
# Forward slashes work for Windows paths.
# ============================================================================

APP_NAME="HDSD Hindi Transcriber"
ENVIRONMENT=development          # development | production
DEBUG=true
LOG_LEVEL=INFO

# --- Database ---------------------------------------------------------------
# Managed Postgres. Paste a provider connection string verbatim -- the
# `postgres://` scheme and libpq query params (`?sslmode=require`,
# `&channel_binding=require`) are normalized for asyncpg automatically.
#
#   Neon (recommended, free):
#   DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/hdsd?sslmode=require
#
#   Local PostgreSQL, if you have one installed:
#   DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hdsd_transcriber
DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/hdsd?sslmode=require
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_RECYCLE_SECONDS=280

# --- Auth -------------------------------------------------------------------
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_generate_a_long_random_value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Login brute-force protection (per email+IP, fixed window)
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# --- CORS -------------------------------------------------------------------
# Comma-separated exact origins. Locally this is the Vite dev server; in
# production add the Vercel production URL (no trailing slash).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Additionally admits Vercel preview deployments, whose hostname changes on
# every commit. Leave blank to allow only the exact origins above.
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# --- Research assets (READ-ONLY -- never written to) ------------------------
HDSD_ROOT=<RESEARCH_ARCHIVE>/hdsd_simple/runs
FULL_FT_DIR=<RESEARCH_ARCHIVE>/hdsd_simple/runs/full_lr5e-06_seed123/best
LORA_DIR=<RESEARCH_ARCHIVE>/hdsd_simple/runs/lora_lr5e-05_seed2026/best
BENCHMARK_DIR=<RESEARCH_ARCHIVE>/hdsd_simple/runs/final_v3/tables

# Verification-only, READ-ONLY. The app itself never reads these; only
# `python -m app.scripts.verify_against_research` does.
PREPARED_DIR=<RESEARCH_ARCHIVE>/hdsd_simple/prepared/v1
FINAL_V3_DIR=<RESEARCH_ARCHIVE>/hdsd_simple/runs/final_v3
HDSD_DATASET_DIR=<HDSD_DATASET>

BASE_MODEL_ID=openai/whisper-small
BASE_MODEL_REVISION=973afd24965f72e36ca33b3055d56a652f456b4d

# Selected training seeds (chosen on development-set WER, not the test set).
# full: seed 123 (dev WER 65.15) | lora: seed 2026 (dev WER 62.24)
FULL_FT_SEED=123
LORA_SEED=2026
FULL_FT_LEARNING_RATE=5e-06
LORA_LEARNING_RATE=5e-05

# --- Inference --------------------------------------------------------------
# false on hosts without the model weights (e.g. Render's free 512 MB
# instance): auth, benchmark and history keep working and the transcription
# endpoints return 503. Keep true for local/GPU runs.
INFERENCE_ENABLED=true
DEVICE=auto                      # auto | cuda | cpu

# VRAM control. `pretrained` and `lora` share one base-model instance (the
# adapter is toggled with PEFT's disable_adapter), which saves ~973 MB and
# lets all three models fit on a 4 GB card.
SHARE_BASE_MODEL=true
# Models kept resident on the GPU at once; 0 = unlimited. Set to 1 to load one
# at a time and unload after use on very small cards.
MAX_RESIDENT_MODELS=0
MAX_NEW_TOKENS=96
CHUNK_SECONDS=30
CHUNK_OVERLAP_SECONDS=0
TARGET_SAMPLE_RATE=16000

# --- Uploads / media --------------------------------------------------------
# Stored outside any web root, UUID filenames.
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=200
MEDIA_RETENTION_DAYS=30
# Bare names work once ffmpeg is on PATH. winget installs it to
# %LOCALAPPDATA%/Microsoft/WinGet/Links but does not refresh running shells,
# so an absolute path is the reliable option on Windows.
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
